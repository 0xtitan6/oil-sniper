# Synthesis Trade API key (required for live trading)
SNIPER_SYNTHESIS_API_KEY=

# Trading mode
SNIPER_DRY_RUN=true
SNIPER_VENUE=polymarket

# Vol detection thresholds
SNIPER_VOL_SIGMA_THRESHOLD=2.5
SNIPER_VOL_MIN_PCT_MOVE=0.3
SNIPER_VOL_COOLDOWN_SECS=30

# Position sizing
SNIPER_MAX_TRADE_SIZE_USD=50
SNIPER_MAX_TOTAL_EXPOSURE_USD=200
SNIPER_MIN_EDGE=0.05
